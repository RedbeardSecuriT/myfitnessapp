{
  "name": "Daily Water Reminders",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "days", "triggerAtHour": 14 }] }
      },
      "name": "Every Day 2pm",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://japan2026-backend-production.up.railway.app/users",
        "options": {}
      },
      "name": "Fetch All Users",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "jsCode": "// Emit reminder for every user — grows automatically as users join\nconst users = $input.first().json.users || [];\nreturn users.map(u => ({\n  json: {\n    userId: u.userId,\n    name: u.name,\n    message: `💧 ${u.name}, don't forget your water! Aim for 100 oz today. Every bottle counts toward your goal. 🏆`\n  }\n}));"
      },
      "name": "Build Water Reminders",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nitems.forEach(i => console.log('Water reminder:', i.json.name, i.json.message));\nreturn items;"
      },
      "name": "Log Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 300]
    }
  ],
  "connections": {
    "Every Day 2pm":         { "main": [[{ "node": "Fetch All Users",        "type": "main", "index": 0 }]] },
    "Fetch All Users":       { "main": [[{ "node": "Build Water Reminders",  "type": "main", "index": 0 }]] },
    "Build Water Reminders": { "main": [[{ "node": "Log Results",            "type": "main", "index": 0 }]] }
  }
}
