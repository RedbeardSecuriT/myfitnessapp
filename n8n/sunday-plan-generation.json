{
  "name": "Sunday Plan Generation",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "weeks", "triggerAtHour": 8, "triggerAtDay": [0] }] }
      },
      "name": "Every Sunday 8am",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://japan2026-backend-production.up.railway.app/users",
        "options": {}
      },
      "name": "Fetch All Users",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "jsCode": "// Emit one item per user — works for 2, 20, or 200 users\nconst response = $input.first().json;\nconst users = response.users || [];\nif (users.length === 0) return [];\nreturn users.map(u => ({ json: u }));"
      },
      "name": "Emit One Item Per User",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://japan2026-backend-production.up.railway.app/generate-week",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": {
          "userId": "={{ $json.userId }}",
          "weekNum": "={{ Math.floor((Date.now() - new Date('2026-05-04').getTime()) / (7 * 24 * 60 * 60 * 1000)) + 1 }}"
        },
        "options": {}
      },
      "name": "Generate Plan For User",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "jsCode": "const results = $input.all();\nresults.forEach(r => {\n  const d = r.json;\n  console.log(`Plan generated for ${d.userId}: ${d.success ? '✅' : '❌'} ${d.error || ''}`);\n});\nreturn results;"
      },
      "name": "Log Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 300]
    }
  ],
  "connections": {
    "Every Sunday 8am":        { "main": [[{ "node": "Fetch All Users",          "type": "main", "index": 0 }]] },
    "Fetch All Users":         { "main": [[{ "node": "Emit One Item Per User",   "type": "main", "index": 0 }]] },
    "Emit One Item Per User":  { "main": [[{ "node": "Generate Plan For User",   "type": "main", "index": 0 }]] },
    "Generate Plan For User":  { "main": [[{ "node": "Log Results",              "type": "main", "index": 0 }]] }
  }
}
